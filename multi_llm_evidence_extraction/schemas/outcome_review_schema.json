{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outcome_review_schema.json",
  "title": "Outcome Review",
  "description": "Post-hoc review for frozen semantic/evidence claims. Outcome fields are review-only and must not be used in initial annotation prompts.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "news_id": {"type": "string", "minLength": 1},
    "ticker": {"type": "string", "minLength": 1},
    "event_date": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1},
    "claim_text": {"type": "string", "minLength": 1},
    "claim_direction": {"type": "string", "enum": ["support", "risk", "neutral", "mixed", "unclear"]},
    "review_window": {"type": "string", "enum": ["T+1", "T+5", "T+20", "T+60", "other"]},
    "raw_return": {"type": ["number", "null"]},
    "benchmark_return": {"type": ["number", "null"]},
    "excess_return": {"type": ["number", "null"]},
    "abnormal_volume": {"type": ["number", "null"]},
    "volatility": {"type": ["number", "null"]},
    "max_adverse_move": {"type": ["number", "null"]},
    "outcome_label": {"type": "string", "enum": ["confirmed", "contradicted", "unresolved", "confounded", "not_price_relevant"]},
    "confounders": {"type": "array", "items": {"type": "string"}},
    "review_reason": {"type": "string"},
    "requires_follow_up": {"type": "boolean"}
  },
  "required": [
    "news_id",
    "ticker",
    "event_date",
    "claim_id",
    "claim_text",
    "claim_direction",
    "review_window",
    "raw_return",
    "benchmark_return",
    "excess_return",
    "abnormal_volume",
    "volatility",
    "max_adverse_move",
    "outcome_label",
    "confounders",
    "review_reason",
    "requires_follow_up"
  ]
}
