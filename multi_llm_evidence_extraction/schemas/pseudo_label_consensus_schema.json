{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pseudo_label_consensus_schema.json",
  "title": "Pseudo Label Consensus",
  "description": "Consensus pseudo-label row built from 2-3 semantic annotators. Not ground truth.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artifact_schema_version": {"type": "string", "const": "pseudo_label_consensus_v2"},
    "news_id": {"type": "string", "minLength": 1},
    "ticker": {"type": "string", "minLength": 1},
    "article_date": {"type": "string", "minLength": 1},
    "annotator_count": {"type": "integer", "minimum": 1, "maximum": 3},
    "consensus_method": {"type": "string", "enum": ["majority_vote", "unanimous", "two_annotator_agreement", "disagreement", "insufficient_annotations"]},
    "agreement_level": {"type": "string", "enum": ["high", "medium", "low", "none", "unclear"]},
    "consensus_ticker_relevance": {"type": "string", "enum": ["direct", "indirect", "market_wide", "irrelevant", "unclear", "disagreement"]},
    "consensus_is_stock_relevant": {"type": ["boolean", "null"]},
    "consensus_event_type": {"type": "string", "enum": ["earnings", "dividend", "capital", "debt", "legal", "governance", "project", "product", "ma", "analyst", "market", "macro", "sector", "other", "unclear", "disagreement"]},
    "consensus_direction": {"type": "string", "enum": ["support", "risk", "neutral", "mixed", "unclear", "disagreement"]},
    "consensus_materiality": {"type": "string", "enum": ["high", "medium", "low", "unclear", "disagreement"]},
    "consensus_materiality_score": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "consensus_expected_impact_score": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "consensus_uncertainty_score": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "consensus_novelty_score": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "consensus_reasoning_confidence": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "consensus_time_horizon": {"type": "string", "enum": ["intraday", "short_term", "medium_term", "long_term", "unclear", "disagreement"]},
    "evidence_span": {"type": ["string", "null"]},
    "disagreement_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "high_disagreement_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "unanimous_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "majority_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "analysis_eligible": {"type": "boolean"},
    "exclusion_reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "quality_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "requires_human_review": {"type": "boolean"},
    "review_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "reason": {"type": "string"}
  },
  "required": [
    "artifact_schema_version", "news_id", "ticker", "article_date", "annotator_count",
    "consensus_method", "agreement_level", "consensus_ticker_relevance",
    "consensus_is_stock_relevant", "consensus_event_type", "consensus_direction",
    "consensus_materiality", "consensus_materiality_score", "consensus_expected_impact_score",
    "consensus_uncertainty_score", "consensus_novelty_score", "consensus_reasoning_confidence",
    "consensus_time_horizon", "evidence_span", "disagreement_fields", "high_disagreement_fields",
    "unanimous_fields", "majority_fields", "analysis_eligible", "exclusion_reasons",
    "quality_flags", "requires_human_review", "review_flags", "reason"
  ]
}
