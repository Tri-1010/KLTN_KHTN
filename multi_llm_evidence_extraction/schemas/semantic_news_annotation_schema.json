{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic_news_annotation_schema.json",
  "title": "Semantic News Annotation",
  "description": "Article-level semantic materiality annotation for Vietnamese stock news. Labels are pseudo labels, not ground truth or recommendations.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "news_id": {"type": "string", "minLength": 1},
    "ticker": {"type": "string", "minLength": 1},
    "company_name": {"type": ["string", "null"]},
    "article_date": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "url": {"type": ["string", "null"]},
    "ticker_relevance": {"type": "string", "enum": ["direct", "indirect", "market_wide", "irrelevant", "unclear"]},
    "is_stock_relevant": {"type": "boolean"},
    "event_type": {"type": "string", "enum": ["earnings", "dividend", "capital", "debt", "legal", "governance", "project", "product", "ma", "analyst", "market", "macro", "sector", "other", "unclear"]},
    "event_subtype": {"type": ["string", "null"]},
    "direction": {"type": "string", "enum": ["support", "risk", "neutral", "mixed", "unclear"]},
    "sentiment": {"type": "string", "enum": ["positive", "negative", "neutral", "mixed", "unclear"]},
    "materiality": {"type": "string", "enum": ["high", "medium", "low", "unclear"]},
    "materiality_score": {"type": "integer", "minimum": 1, "maximum": 5},
    "expected_impact_score": {"type": "integer", "minimum": 1, "maximum": 5},
    "uncertainty_score": {"type": "integer", "minimum": 1, "maximum": 5},
    "novelty_score": {"type": "integer", "minimum": 1, "maximum": 5},
    "time_horizon": {"type": "string", "enum": ["intraday", "short_term", "medium_term", "long_term", "unclear"]},
    "evidence_span": {"type": ["string", "null"], "description": "Exact quote from supplied article text, or null when no reliable span exists."},
    "summary": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "reasoning_confidence": {"type": "integer", "minimum": 1, "maximum": 5},
    "requires_human_review": {"type": "boolean"},
    "data_quality_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "required": [
    "news_id",
    "ticker",
    "company_name",
    "article_date",
    "source",
    "title",
    "url",
    "ticker_relevance",
    "is_stock_relevant",
    "event_type",
    "event_subtype",
    "direction",
    "sentiment",
    "materiality",
    "materiality_score",
    "expected_impact_score",
    "uncertainty_score",
    "novelty_score",
    "time_horizon",
    "evidence_span",
    "summary",
    "reason",
    "reasoning_confidence",
    "requires_human_review",
    "data_quality_flags"
  ]
}
