    "benchmark": "fc44a4a3afd01ea0a48dfc8901377b8af24e5e5eaa7da73cb4639063dbc83f84",
    "technical": "b0a1cb2e7ea71708131cc444de07e1457bc2d457e9e2a255af418f480f324e3e",
    "keyword": "bd8d7e048a76f7f701401d5e8604a4fa0263cf4c2577e95658eac3b70135f4ed",
    "semantic_daily": "3755fbbef05c608db80c65d2f525215169a0bdd535d3ee634aacf23ee41b25f0",
    "semantic_consensus": "6342f27827e3327b78099fc1e1bbf13d4340c598764379dff0b14ac5f357da54",
    "news_matched": "349947bbabacd1bd3292ef59df8bc5776db3748a7ce5d90da49a5ce5a7441477",
